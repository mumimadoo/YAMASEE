# ==============================================================================
# YAMASEE Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your own settings.
# Do NOT commit the '.env' file containing actual secrets to any repository!

# ------------------------------------------------------------------------------
# Application Environment Settings
# ------------------------------------------------------------------------------
# Options: development, production
APP_ENV=development

# Cryptographically secure secret key used for session signing and encryption.
# In production, this must be set and must be at least 32 characters (prefer 64+).
# Generate locally using: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=change_me_with_a_long_random_secret

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# SQLite (Local Development Only)
# DATABASE_URL=sqlite:///./data/yamasee.db

# PostgreSQL (Production & Hardened Development)
# - For local host usage, replace 'postgres' with '127.0.0.1' or 'localhost'.
# - For future Docker Compose environments, use the container hostname 'postgres'.
DATABASE_URL=postgresql+psycopg://yamasee_app:change_me@postgres:5432/yamasee

# ------------------------------------------------------------------------------
# AI Integration API Keys
# ------------------------------------------------------------------------------
# Google Gemini API key used by the strategic audio analysis pipeline.
# Get your API key from Google AI Studio.
GEMINI_API_KEY=change_me

# Enable distribution checks during transcription chunk slicing.
# Options: true, false
ENABLE_DISTRIBUTION_CHECK=false

# ------------------------------------------------------------------------------
# Security & Session Settings
# ------------------------------------------------------------------------------
# Force secure HTTPS cookies.
# Must be set to 'true' when APP_ENV is 'production'.
SESSION_HTTPS_ONLY=false

# Session cookie lifetime in seconds (default is 7 days: 604800)
SESSION_MAX_AGE_SECONDS=604800

# ------------------------------------------------------------------------------
# Storage & Media Settings
# ------------------------------------------------------------------------------
# Retain original download files after analysis completes.
# Options: true, false (default is false)
KEEP_MEDIA_FILES=false
